---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { laadGrondtekstHoofdstuk, zoekVindplaatsen } from "../../lib/grondtekst";
import type { Koppeling } from "../../lib/vertalingtabs";

interface BoekInfo {
	code: string;
	nummer: number;
	naam_en: string;
	naam_nl: string;
	testament: "ot" | "nt";
	hoofdstukken: number;
}

const DATA_ROOT = path.join(process.cwd(), "..", "data", "kjv");
const BEREA_ROOT = path.join(process.cwd(), "..", "data", "bijbel");
const STATEN_ROOT = path.join(process.cwd(), "..", "data", "staten");

// Zelfde schakelaar als noindex (zie Base.astro): KJV is alleen vuldata in de demo.
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
const toonKjv = !indexable;

export async function getStaticPaths() {
	const dataRoot = path.join(process.cwd(), "..", "data", "kjv");
	const index: BoekInfo[] = JSON.parse(
		fs.readFileSync(path.join(dataRoot, "index.json"), "utf-8"),
	);

	const paths = [];
	for (const boek of index) {
		for (let h = 1; h <= boek.hoofdstukken; h++) {
			paths.push({
				params: { boek: boek.code, hoofdstuk: String(h) },
				props: { boekInfo: boek, alleBoeken: index },
			});
		}
	}
	return paths;
}

const { boek, hoofdstuk } = Astro.params;
const { boekInfo, alleBoeken } = Astro.props as { boekInfo: BoekInfo; alleBoeken: BoekInfo[] };

const hoofdstukNummer = Number(hoofdstuk);
const bestandsnaam = String(hoofdstukNummer).padStart(2, "0") + ".json";
const hoofdstukData = JSON.parse(
	fs.readFileSync(path.join(DATA_ROOT, boek!, bestandsnaam), "utf-8"),
);
const kjvVerzen: { vers: number; tekst: string }[] = hoofdstukData.verzen;

// BereaBijbel is de hoofdvertaling; nog niet vertaalde hoofdstukken hebben geen bestand.
interface BereaVoetnoot { nr: number; anker: string | null; tekst: string }
interface BereaVers { vers: number; tekst: string; voetnoten?: BereaVoetnoot[]; koppeling?: Koppeling[] }
let bereaVerzen: BereaVers[] = [];
try {
	bereaVerzen = JSON.parse(
		fs.readFileSync(path.join(BEREA_ROOT, boek!, bestandsnaam), "utf-8"),
	).verzen;
} catch {}
const bereaPerVers = new Map(bereaVerzen.map((v) => [v.vers, v]));
const kjvPerVers = new Map(kjvVerzen.map((v) => [v.vers, v.tekst]));
// Statenvertaling (publiek domein) naast de BereaBijbel; zelfde schakelaar als de KJV (demo).
let statenPerVers = new Map<number, string>();
try {
	const staten: { vers: number; tekst: string }[] = JSON.parse(
		fs.readFileSync(path.join(STATEN_ROOT, boek!, bestandsnaam), "utf-8"),
	).verzen;
	statenPerVers = new Map(staten.map((v) => [v.vers, v.tekst]));
} catch {}

// Versnummers volgen de vertaling; zonder vertaling de KJV (zelfde versindeling).
const verzen = bereaVerzen.length > 0 ? bereaVerzen : kjvVerzen;

const hoofdstukkenVanDitBoek = Array.from({ length: boekInfo.hoofdstukken }, (_, i) => i + 1);

// Grondtekst + Strong-nummers erbij, indien beschikbaar voor dit hoofdstuk.
const naamPerCode = new Map(alleBoeken.map((b) => [b.code, b.naam_nl]));
const grondtekstHoofdstuk = laadGrondtekstHoofdstuk(boekInfo.testament, boek!, hoofdstukNummer);
const grondtekstPerVers = new Map(
	(grondtekstHoofdstuk?.verzen ?? []).map((v) => [v.vers, v]),
);

const versDetail: Record<
	number,
	{
		berea: { tekst: string; voetnoten: BereaVoetnoot[] } | null;
		kjv: string | null;
		staten: string | null;
		koppeling: Koppeling[] | null;
		rtl: boolean;
		grondtekst: string | null;
		woorden: {
			tekst: string;
			strong: string;
			morf: string | null;
			vindplaatsen: { totaal: number; voorbeelden: { boek: string; naam: string; hoofdstuk: number; vers: number; tekst: string }[] };
		}[];
	}
> = {};

for (const v of verzen) {
	const gt = grondtekstPerVers.get(v.vers);
	const berea = bereaPerVers.get(v.vers);
	versDetail[v.vers] = {
		berea: berea ? { tekst: berea.tekst, voetnoten: berea.voetnoten ?? [] } : null,
		kjv: toonKjv ? (kjvPerVers.get(v.vers) ?? null) : null,
		staten: toonKjv ? (statenPerVers.get(v.vers) ?? null) : null,
		koppeling: berea?.koppeling ?? null,
		rtl: boekInfo.testament === "ot",
		grondtekst: gt ? gt.woorden.map((w) => w.tekst).join(" ") : null,
		woorden: (gt?.woorden ?? []).map((w) => {
			const { totaal, voorbeelden } = zoekVindplaatsen(w.strong, {
				boek: boek!,
				hoofdstuk: hoofdstukNummer,
				vers: v.vers,
			});
			return {
				tekst: w.tekst,
				strong: w.strong,
				morf: w.morf,
				vindplaatsen: {
					totaal,
					voorbeelden: voorbeelden.map((vp) => ({
						...vp,
						naam: naamPerCode.get(vp.boek) ?? vp.boek,
					})),
				},
			};
		}),
	};
}

// Vorige en volgende hoofdstuk, ook over boekgrenzen heen.
const boekIndex = alleBoeken.findIndex((b) => b.code === boek);
function koppelNaar(code: string, hoofdstuknr: number) {
	const b = alleBoeken.find((x) => x.code === code)!;
	return { href: `/${code}/${hoofdstuknr}`, naam: `${b.naam_nl} ${hoofdstuknr}` };
}
const vorige =
	hoofdstukNummer > 1
		? koppelNaar(boek!, hoofdstukNummer - 1)
		: boekIndex > 0
			? koppelNaar(alleBoeken[boekIndex - 1].code, alleBoeken[boekIndex - 1].hoofdstukken)
			: null;
const volgende =
	hoofdstukNummer < boekInfo.hoofdstukken
		? koppelNaar(boek!, hoofdstukNummer + 1)
		: boekIndex < alleBoeken.length - 1
			? koppelNaar(alleBoeken[boekIndex + 1].code, 1)
			: null;
---

<Base title={`${boekInfo.naam_nl} ${hoofdstukNummer} — BereaBijbel`} huidigeNav="bijbel">
	<p class="kruimel"><a href="/bijbel">Bijbel</a> › <a href={`/${boek}/`}>{boekInfo.naam_nl}</a></p>
	<div class="zoekbalk">
		<svg class="zoek-icoon" width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
			<path d="M13.3 13.3 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
		</svg>
		<input id="search" type="text" placeholder="Zoek op vers" autocomplete="off" />
	</div>
	<div id="search-error" class="search-error" hidden></div>

	<h1 id="hoofdstuktitel">{boekInfo.naam_nl} {hoofdstukNummer}</h1>

	<nav class="hfdnav">
		<select id="book-select">
			{alleBoeken.map((b) => (
				<option value={b.code} selected={b.code === boek}>{b.naam_nl}</option>
			))}
		</select>
		<select id="chapter-select">
			{hoofdstukkenVanDitBoek.map((h) => (
				<option value={h} selected={h === hoofdstukNummer}>{h}</option>
			))}
		</select>
	</nav>

	<div class="weergave-rij">
		<div class="weergave" role="group" aria-label="Weergave">
			<button type="button" data-modus="lezen" aria-pressed="false">Lezen</button>
			<button type="button" data-modus="studie" aria-pressed="true">Studie</button>
		</div>
		<span class="weergave-hint" id="weergave-hint">Klik op een vers voor de grondtekst.</span>
	</div>

	<div id="chapter-verses">
		{verzen.map((v) => (
			<div class="vers" id={`vers-${v.vers}`} data-vers={v.vers}>
				<div class="vers-hoofd">
					<div class="vnr">{v.vers}</div>
					{bereaPerVers.has(v.vers) ? (
						<div class="vtekst">{v.tekst}</div>
					) : toonKjv ? (
						<div class="vtekst placeholder-tekst">{v.tekst}</div>
					) : (
						<div class="vtekst placeholder-tekst">Nog niet vertaald.</div>
					)}
					<button class="meld-btn" type="button" title="Verbetering voorstellen bij dit vers" data-meld>
						<svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M5 17V4M5 4h9l-2 3 2 3H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
				</div>
			</div>
		))}
	</div>

	<nav class="bladeren" aria-label="Hoofdstuk bladeren">
		{vorige ? <a class="bladeren-knop" href={vorige.href} rel="prev">&larr; {vorige.naam}</a> : <span></span>}
		{volgende ? <a class="bladeren-knop primair" href={volgende.href} rel="next">{volgende.naam} &rarr;</a> : <span></span>}
	</nav>

	<style is:global>
		.kruimel { margin: 0 0 1.4rem; text-align: center; font-family: var(--ui-font); font-size: 0.9rem; color: var(--tertiary); }
		.kruimel a { color: var(--tertiary); }
		.weergave-rij { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.6rem 1rem; margin: 0 0 1.6rem; font-family: var(--ui-font); }
		.weergave { display: inline-flex; gap: 0.25rem; padding: 0.25rem; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; box-shadow: 0 6px 18px rgba(35, 43, 77, 0.06); }
		.weergave button { min-height: 2.3rem; padding: 0 1.2rem; border: 0; border-radius: 999px; background: transparent; font: 700 0.9rem var(--ui-font); color: var(--tertiary); cursor: pointer; }
		.weergave button[aria-pressed="true"] { background: var(--goud); color: var(--goud-tekst); }
		.weergave-hint { font-size: 0.85rem; color: var(--tertiary); }
		#chapter-verses.modus-lezen .vnr, #chapter-verses.modus-lezen .meld-btn { display: none; }
		#chapter-verses.modus-lezen .vers-hoofd { cursor: text; padding-left: 0.8rem; }
		#chapter-verses.modus-lezen .vers-hoofd:hover { background: none; }
		#chapter-verses.modus-lezen { font-size: 1.2rem; line-height: 1.9; }
		.bladeren { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.6rem; }
		.bladeren-knop { display: inline-flex; align-items: center; min-height: 2.9rem; padding: 0 1.4rem; border: 1.5px solid var(--border); border-radius: 999px; font-family: var(--ui-font); font-weight: 700; font-size: 0.95rem; color: var(--dark); text-decoration: none; background: var(--bg); }
		.bladeren-knop:hover { background: var(--bg-soft); }
		.bladeren-knop.primair { background: var(--goud); border-color: var(--goud); color: var(--goud-tekst); }
	</style>

	<script type="application/json" id="boekenindex" set:html={JSON.stringify(alleBoeken)} />
	<script type="application/json" id="versdetail" set:html={JSON.stringify(versDetail)} />

	<script>
		import { vulDetailPaneel, type VersDetail } from "../../lib/vertalingtabs";

		function normalizeBoek(s: string) {
			return s.trim().toLowerCase().replace(/\./g, "");
		}

		function initZoek() {
			const el = document.getElementById("boekenindex");
			if (!el) return;
			const boeken: { code: string; naam_nl: string; hoofdstukken: number }[] = JSON.parse(el.textContent || "[]");

			const zoekEl = document.getElementById("search") as HTMLInputElement | null;
			const errorEl = document.getElementById("search-error");
			if (!zoekEl || !errorEl) return;

			zoekEl.addEventListener("keydown", (e) => {
				if (e.key !== "Enter") return;
				e.preventDefault();
				errorEl.hidden = true;
				const query = zoekEl.value.trim();
				if (!query) return;

				const m = query.match(/^(.*?)\s+(\d+)(?::(\d+))?\s*$/);
				if (!m) {
					errorEl.textContent = 'Gebruik het formaat "Boek hoofdstuk:vers", bijv. "Johannes 3:16".';
					errorEl.hidden = false;
					return;
				}
				const rawBoek = normalizeBoek(m[1]);
				const gevonden = boeken.find((b) => normalizeBoek(b.naam_nl).indexOf(rawBoek) === 0);
				if (!gevonden) {
					errorEl.textContent = `Boek "${m[1]}" niet gevonden.`;
					errorEl.hidden = false;
					return;
				}
				const hst = parseInt(m[2], 10);
				if (hst < 1 || hst > gevonden.hoofdstukken) {
					errorEl.textContent = `${gevonden.naam_nl} heeft ${gevonden.hoofdstukken} hoofdstukken.`;
					errorEl.hidden = false;
					return;
				}
				const vers = m[3] ? `#vers-${m[3]}` : "";
				window.location.href = `/${gevonden.code}/${hst}${vers}`;
			});
		}

		function initSelects() {
			const boekSelect = document.getElementById("book-select") as HTMLSelectElement | null;
			const hstSelect = document.getElementById("chapter-select") as HTMLSelectElement | null;
			if (boekSelect) {
				boekSelect.addEventListener("change", () => {
					window.location.href = `/${boekSelect.value}/1`;
				});
			}
			if (hstSelect) {
				hstSelect.addEventListener("change", () => {
					const boek = window.location.pathname.split("/")[1];
					window.location.href = `/${boek}/${hstSelect.value}`;
				});
			}
		}

		function initVersen() {
			const el = document.getElementById("versdetail");
			const versDetail: Record<string, VersDetail> = el
				? JSON.parse(el.textContent || "{}")
				: {};

			document.querySelectorAll<HTMLElement>(".vers").forEach((row) => {
				const hoofd = row.querySelector(".vers-hoofd");
				hoofd?.addEventListener("click", (e) => {
					if ((e.target as HTMLElement).closest("[data-meld]")) return;
					if (document.getElementById("chapter-verses")?.classList.contains("modus-lezen")) return;
					const open = row.classList.contains("open");
					document.querySelectorAll(".vers.open").forEach((r) => {
						r.classList.remove("open");
						r.querySelector(".vers-detail")?.remove();
					});
					if (open) return;
					row.classList.add("open");

					const versNummer = row.dataset.vers!;
					const detail = versDetail[versNummer];

					const panel = document.createElement("div");
					panel.className = "vers-detail";
					if (!detail) {
						panel.innerHTML =
							'<p class="placeholder-detail">Nog geen grondtekst gekoppeld aan dit vers.</p>';
						row.appendChild(panel);
						return;
					}

					row.appendChild(panel);
					vulDetailPaneel(panel, detail);
				});
			});

			document.querySelectorAll<HTMLElement>("[data-meld]").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.stopPropagation();
					(window as any).toonToast?.(
						"Bedankt voor je melding — wordt in deze testversie nog niet verwerkt.",
					);
				});
			});
		}

		function markeerVanuitHash() {
			const hash = window.location.hash;
			if (!hash) return;
			const target = document.querySelector(hash);
			if (!target) return;
			target.scrollIntoView({ behavior: "smooth", block: "center" });
			target.classList.add("flits");
			setTimeout(() => target.classList.remove("flits"), 1600);
		}

		function initModus() {
			const verzen = document.getElementById("chapter-verses");
			const hint = document.getElementById("weergave-hint");
			const knoppen = document.querySelectorAll<HTMLButtonElement>(".weergave button");
			if (!verzen) return;
			function zet(modus: string) {
				const lezen = modus === "lezen";
				verzen!.classList.toggle("modus-lezen", lezen);
				knoppen.forEach((k) => k.setAttribute("aria-pressed", String(k.dataset.modus === modus)));
				if (hint) hint.hidden = lezen;
				if (lezen) {
					document.querySelectorAll(".vers.open").forEach((r) => {
						r.classList.remove("open");
						r.querySelector(".vers-detail")?.remove();
					});
				}
				try { localStorage.setItem("bb-modus", modus); } catch {}
			}
			knoppen.forEach((k) => k.addEventListener("click", () => zet(k.dataset.modus!)));
			let bewaard = "studie";
			try { bewaard = localStorage.getItem("bb-modus") === "lezen" ? "lezen" : "studie"; } catch {}
			zet(bewaard);
		}

		initZoek();
		initSelects();
		initVersen();
		initModus();
		markeerVanuitHash();
	</script>
</Base>
