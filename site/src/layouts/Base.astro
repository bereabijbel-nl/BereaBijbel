---
interface Props {
	title?: string;
	huidigeNav?: "home" | "over" | "contact" | "bijbel";
}

const { title = "BereaBijbel", huidigeNav = "" } = Astro.props;

// Alleen indexeerbaar als expliciet ingesteld via omgevingsvariabele.
// Standaard (niet ingesteld, demo, preview) = noindex.
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
---

<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{!indexable && <meta name="robots" content="noindex,nofollow" />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{title}</title>
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Caveat:wght@500&display=swap");

			:root {
				--light: #fefefb;
				--lightgray: #ebe6d6;
				--gray: #8d8b9c;
				--darkgray: #2a3050;
				--dark: #1f2440;
				--secondary: #232b4d;
				--tertiary: #55566a;
				--bg: var(--light);
				--bg-soft: #fcf8ea;
				--border: var(--lightgray);
				--tekst: var(--darkgray);
				--accent: var(--secondary);
				--accent-donker: var(--dark);
				--goud: #f2b632;
				--goud-tekst: #232b4d;
				--markering: #ffe7a0;
				--lucht: #fffcee;
				--water: #5aa9d6;
				--body-font: "Source Serif 4", Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, serif;
				--ui-font: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
				--kop-font: "Fraunces", "Source Serif 4", Georgia, serif;
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--light: #14172b;
					--lightgray: #2b3050;
					--gray: #6d7194;
					--darkgray: #dfe1f0;
					--dark: #f4f4fb;
					--secondary: #e6e8f5;
					--tertiary: #a4a8c6;
					--bg-soft: #1c2040;
					--accent: #f2b632;
					--accent-donker: #f4f4fb;
					--lucht: #1c2040;
					--markering: #5b4713;
				}
			}
			:root[data-theme="dark"] {
				--light: #14172b;
				--lightgray: #2b3050;
				--gray: #6d7194;
				--darkgray: #dfe1f0;
				--dark: #f4f4fb;
				--secondary: #e6e8f5;
				--tertiary: #a4a8c6;
				--bg-soft: #1c2040;
				--accent: #f2b632;
				--accent-donker: #f4f4fb;
				--lucht: #1c2040;
				--markering: #5b4713;
			}

			* { box-sizing: border-box; }
			html, body { margin: 0; padding: 0; }
			body {
				font-family: var(--body-font);
				background: var(--bg);
				color: var(--tekst);
				line-height: 1.7;
				-webkit-font-smoothing: antialiased;
			}
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			::selection { background: var(--markering); }
			a { color: var(--accent); }

			.kopwrap { padding: 1.1rem 1rem 0; }
			.site-header {
				max-width: 1100px;
				margin: 0 auto;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.6rem 1.5rem;
				padding: 0.55rem 0.6rem 0.55rem 1.4rem;
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 999px;
				box-shadow: 0 8px 26px rgba(35, 43, 77, 0.07);
			}
			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-family: var(--kop-font);
				font-size: 1.45rem;
				font-weight: 500;
				color: var(--dark);
				text-decoration: none;
			}
			.logo:hover { color: var(--dark); }
			.site-nav {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3rem 1.5rem;
				font-family: var(--ui-font);
				font-size: 0.98rem;
				font-weight: 600;
			}
			.site-nav a { color: var(--tekst); text-decoration: none; }
			.site-nav a:hover { text-decoration: underline; }
			.site-nav a[aria-current="true"] { color: var(--dark); text-decoration: underline; text-decoration-color: var(--goud); text-decoration-thickness: 3px; text-underline-offset: 6px; }
			.site-nav a.nav-cta {
				display: inline-flex;
				align-items: center;
				min-height: 2.6rem;
				padding: 0 1.3rem;
				background: var(--goud);
				color: var(--goud-tekst);
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
			}
			.site-nav a.nav-cta:hover { text-decoration: none; filter: brightness(0.96); }

			main {
				max-width: 700px;
				margin: 0 auto;
				padding: 3rem 1.2rem 4.5rem;
			}

			.prose p { margin: 0 0 1.1rem; }
			.prose ul { margin: 0 0 1.1rem; padding-left: 1.3rem; }
			.prose li { margin-bottom: 0.4rem; }
			h2.sectie {
				font-family: var(--kop-font);
				font-size: 1.55rem;
				font-weight: 500;
				color: var(--dark);
				margin: 2.2rem 0 1rem;
			}
			h2.sectie:first-child { margin-top: 0; }

			footer.foot {
				max-width: 700px;
				margin: 0 auto;
				text-align: center;
				padding: 1.4rem 1.2rem 3rem;
				border-top: 1px solid var(--border);
				font-family: var(--ui-font);
				font-size: 0.8rem;
				color: var(--tertiary);
			}
			footer.foot p { margin: 0 0 0.5rem; }
			footer.foot span { margin: 0 0.6rem; }

			.toast {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%);
				background: var(--dark);
				color: var(--light);
				padding: 0.5rem 1rem;
				border-radius: 999px;
				font-family: var(--ui-font);
				font-size: 0.85rem;
				opacity: 0.95;
				z-index: 50;
			}
			.toast[hidden] { display: none; }
		</style>
		<style is:global>
			/* ---------- zoekbalk, hoofdstuknavigatie: gedeeld door home en hoofdstukpagina's ---------- */
			.zoekbalk {
				position: relative;
				max-width: 640px;
				margin: 0 auto 1.6rem;
			}
			#search {
				display: block;
				box-sizing: border-box;
				width: 100%;
				font-family: var(--ui-font);
				font-size: 1.05rem;
				line-height: 1.5;
				text-align: center;
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.75rem 2.4rem 0.75rem 2.4rem;
				color: var(--tekst);
				background: var(--bg);
				box-shadow: 0 8px 24px rgba(35, 43, 77, 0.07);
			}
			#search::placeholder { color: var(--tertiary); }
			#search:focus { outline: none; border-color: var(--goud); box-shadow: 0 0 0 3px rgba(242, 182, 50, 0.35); }
			.zoek-icoon {
				position: absolute;
				left: calc(50% - 73px);
				top: 50%;
				transform: translateY(-50%);
				color: var(--tertiary);
				pointer-events: none;
			}
			.search-error {
				max-width: 640px;
				margin: 0.4rem auto 0;
				color: #a33;
				font-size: 0.8rem;
				font-family: var(--ui-font);
				text-align: center;
			}
			.search-error[hidden] { display: none; }

			#hoofdstuktitel {
				text-align: center;
				font-family: var(--kop-font);
				font-size: 2.2rem;
				font-weight: 400;
				letter-spacing: -0.01em;
				color: var(--dark);
				margin: 2rem 0 0.4rem;
			}

			.hfdnav {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.6rem;
				flex-wrap: wrap;
				padding: 1rem 0;
				margin-bottom: 1.1rem;
			}
			.hfdnav select {
				font-family: var(--ui-font);
				font-size: 1rem;
				font-weight: 500;
				line-height: 1.7;
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.3rem 1.6rem 0.3rem 0.9rem;
				background: var(--bg);
				color: var(--tekst);
				cursor: pointer;
			}
			.hfdnav select:focus { outline: none; border-color: var(--goud); }

			/* ---------- versregels en detailpaneel ---------- */
			#chapter-verses, #home-verses { font-size: 1.1rem; }
			.vers { position: relative; border-radius: 16px; line-height: 1.75; }
			.vers-hoofd {
				display: flex;
				gap: 0.8rem;
				padding: 0.5rem 0.8rem 0.5rem 0.4rem;
				border-radius: 16px;
				cursor: pointer;
			}
			.vers-hoofd:hover { background: var(--bg-soft); }
			.vers.open { box-shadow: 0 0 0 1px var(--border); }
			.vers.open .vers-hoofd { border-radius: 16px 16px 0 0; background: var(--bg-soft); }
			.vnr {
				color: var(--tertiary);
				font-size: 0.75rem;
				min-width: 1.7rem;
				text-align: right;
				padding-top: 0.35rem;
				flex-shrink: 0;
				font-family: var(--ui-font);
				font-weight: 600;
			}
			.vtekst { flex: 1; }
			.vers-detail {
				/* links op één lijn met de verstekst: 0,4 (padding) + 1,7 (nummer) + 0,8 (tussenruimte) */
				padding: 0.4rem 1.2rem 1.3rem 2.9rem;
				font-size: 0.92rem;
				background: var(--bg-soft);
				border-radius: 0 0 16px 16px;
			}
			@media (max-width: 560px) { .vers-detail { padding-left: 1.2rem; } }
			.placeholder-detail { font-style: italic; color: var(--tertiary); margin: 0 0 0.8rem; }

			.tabs { display: flex; gap: 1.2rem; border-bottom: 1px solid var(--border); margin-bottom: 0.9rem; }
			.tab {
				font-family: var(--ui-font);
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--tertiary);
				background: none;
				border: none;
				border-bottom: 3px solid transparent;
				padding: 0.2rem 0 0.5rem;
				margin-bottom: -1px;
				cursor: pointer;
			}
			.tab:hover { color: var(--accent-donker); }
			.tab[aria-selected="true"] { color: var(--accent-donker); border-bottom-color: var(--goud); }
			.tab-paneel[hidden] { display: none; }
			.tab-paneel { margin-bottom: 0; }
			.tab-vers { margin: 0; font-size: 1rem; line-height: 1.7; }
			.vertaling + .vertaling { margin-top: 1.3rem; }
			.vt-label { font-family: var(--ui-font); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tertiary); margin: 0 0 0.25rem; }
			.vt-leeg { font-style: italic; color: var(--tertiary); }
			.voetnoten { margin: 0; padding-left: 0; list-style: none; font-size: 0.88rem; line-height: 1.6; color: var(--tekst); }
			.voetnoten li { margin-bottom: 0.4rem; padding: 0.3rem 0.5rem; margin-left: -0.5rem; border-radius: 8px; }
			.voetnoten li.actief { background: var(--markering); }
			.vn-anker { font-weight: 600; color: var(--accent-donker); }
			.vn-anker::after { content: " —"; font-weight: 400; }

			/* Woordenraster: gelijke cellen; grondtekst, Nederlandse tegenhanger, Strong-nummer. */
			.segmenten {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(5.4rem, 1fr));
				gap: 0.5rem;
			}
			.segment {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: flex-start;
				gap: 0.2rem;
				text-align: center;
				padding: 0.55rem 0.3rem 0.5rem;
				border: 1px solid transparent;
				border-radius: 12px;
				background: none;
				font: inherit;
				color: inherit;
				cursor: pointer;
			}
			.segment:hover, .segment.licht { background: var(--markering); }
			.segment:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
			.seg-grondtekst { font-size: 1.15rem; line-height: 1.3; color: var(--dark); font-style: normal; }
			.seg-nl { font-size: 0.88rem; line-height: 1.3; color: var(--tekst); }
			.seg-nl.leeg { color: var(--tertiary); }
			.seg-strong { font-family: var(--ui-font); font-size: 0.72rem; color: var(--tekst); opacity: 0.85; }
			/* Wederzijds: muis op een grondtekstblok licht het Nederlandse woord op, en andersom.
			   Er licht altijd maar één paar tegelijk op. */
			.vw { border-radius: 6px; transition: background 0.12s; }
			.vw.licht, .vers.open .vw:hover { background: var(--markering); box-shadow: 0 0 0 2px var(--markering); }
			.toevoeging-note { margin: 0.8rem 0 0; font-size: 0.8rem; color: var(--tertiary); }

			.woord-uitleg {
				margin-top: 1rem;
				padding-top: 0.9rem;
				border-top: 1px solid var(--border);
				font-size: 0.88rem;
				text-align: left;
			}
			.woord-uitleg[hidden] { display: none; }
			.uitleg-intro { margin: 0 0 0.6rem; color: var(--tekst); }
			.uitleg-intro b { color: var(--accent-donker); }
			.field-label {
				font-family: var(--ui-font);
				font-size: 0.68rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--tertiary);
				margin: 1.2rem 0 0.4rem;
			}
			.vindplaatsen-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.2rem; }
			.vp-item { padding: 0.3rem 0.4rem; border-radius: 8px; }
			.vp-item-hoofd { display: flex; gap: 0.6rem; font-size: 0.88rem; }
			.vp-ref { color: var(--tekst); font-weight: 600; min-width: 9rem; text-decoration: none; }
			a.vp-ref:hover, a.vp-ref:focus-visible { text-decoration: underline; color: var(--dark); }
			.vp-vorm { font-style: italic; color: var(--dark); }
			.vp-item:hover { background: var(--lightgray); }
			.vp-voorbeeld { margin: 0.7rem 0 0; padding: 0.7rem 0.9rem; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; }
			.vp-voorbeeld[hidden] { display: none; }
			.vp-voorbeeld p { margin: 0; }
			.vp-vers { font-size: 1rem; line-height: 1.6; }
			.vp-bron { font-family: var(--ui-font); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tertiary); margin-right: 0.3rem; }
			.vp-vers + .vp-vers { margin-top: 0.7rem; }
			.vp-grondtekst:first-child { margin-top: 0 !important; }
			.vp-grondtekst + .vp-vers { margin-top: 1.3rem; }
			.vp-grondtekst { margin-top: 1.3rem !important; font-size: 1.02rem; line-height: 1.7; color: var(--dark); }
			.bet-def { margin: 0 0 0.3rem; line-height: 1.55; }
			.bet-kjv { margin: 0 0 0.6rem; line-height: 2; }
			.chip { display: inline-block; padding: 0.05rem 0.7rem; margin: 0 0.35rem 0.1rem 0; font-size: 0.85rem; line-height: 1.6; color: var(--tekst); background: var(--bg); border: 1px solid var(--border); border-radius: 999px; text-decoration: none; }
			a.chip:hover { background: var(--markering); color: var(--dark); }
			.alle-link { color: var(--tekst); text-decoration: none; }
			.alle-link:hover { color: var(--dark); text-decoration: underline; }
			.vindplaatsen-note { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--tertiary); }

			.meld-btn {
				flex-shrink: 0;
				align-self: flex-start;
				margin-top: 0.3rem;
				width: 1.6rem;
				height: 1.6rem;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				border-radius: 999px;
				background: none;
				color: var(--tertiary);
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.15s, background 0.15s, color 0.15s;
			}
			.vers-hoofd:hover .meld-btn { opacity: 1; }
			.meld-btn:hover { background: var(--markering); color: var(--accent-donker); }

			@keyframes flits {
				0% { background: var(--markering); }
				100% { background: var(--bg-soft); }
			}
			.vers.flits .vers-hoofd { animation: flits 1.6s ease-out 1; }

			.cta-wrap { text-align: center; margin-top: 1.6rem; }
			.pill-btn {
				display: inline-block;
				font-family: var(--ui-font);
				font-size: 1rem;
				font-weight: 700;
				color: var(--goud-tekst);
				background: var(--goud);
				border: none;
				padding: 0.7rem 1.6rem;
				border-radius: 999px;
				cursor: pointer;
				text-decoration: none;
			}
			.pill-btn:hover { filter: brightness(0.96); color: var(--goud-tekst); }

			/* ---------- hero op de voorpagina ---------- */
			.hero-wrap { padding: 1.5rem 1rem 0; }
			.hero {
				position: relative;
				max-width: 1100px;
				margin: 0 auto;
				padding: 4.2rem 2rem 5.5rem;
				background: var(--lucht);
				border: 1px solid var(--border);
				border-radius: 36px;
				overflow: hidden;
				text-align: center;
			}
			.hero-ringen { position: absolute; right: -90px; top: -90px; width: 380px; height: 380px; pointer-events: none; }
			.hero-golf { position: absolute; left: 0; bottom: 0; width: 100%; height: 80px; pointer-events: none; }
			.hero-inhoud { position: relative; max-width: 680px; margin: 0 auto; }
			.hero-oog { margin: 0 0 1rem; font-family: var(--ui-font); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tertiary); }
			.hero h1 {
				margin: 0;
				font-family: var(--kop-font);
				font-size: clamp(2.2rem, 5.5vw, 3.6rem);
				font-weight: 400;
				line-height: 1.1;
				letter-spacing: -0.02em;
				color: var(--dark);
			}
			.hero h1 .mark { background: var(--markering); border-radius: 8px; padding: 0 0.15em; }
			.hero p.hero-tekst { margin: 1.4rem auto 0; max-width: 560px; font-size: 1.15rem; line-height: 1.6; color: var(--tekst); }
			.hero-knoppen { margin-top: 1.8rem; display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; font-family: var(--ui-font); }
			.hero-knoppen a.tweede { display: inline-block; padding: 0.7rem 1.5rem; border: 1.5px solid var(--dark); border-radius: 999px; color: var(--dark); font-weight: 700; text-decoration: none; }
			.hero-knoppen a.tweede:hover { background: var(--bg-soft); }

			@media (prefers-reduced-motion: reduce) {
				* { transition: none !important; }
			}
		</style>
	</head>
	<body>
		<div class="kopwrap">
			<header class="site-header">
				<a class="logo" href="/">
					<svg width="30" height="27" viewBox="0 0 34 30" aria-hidden="true"><rect x="1" y="2" width="30" height="7" rx="3.5" fill="#232b4d"/><rect x="4" y="11.5" width="26" height="7" rx="3.5" fill="#f2b632"/><rect x="1" y="21" width="20" height="7" rx="3.5" fill="#5aa9d6"/></svg>
					BereaBijbel
				</a>
				<nav class="site-nav" aria-label="Hoofdmenu">
					<a href="/" aria-current={huidigeNav === "home" ? "true" : "false"}>Home</a>
					<a href="/bijbel" aria-current={huidigeNav === "bijbel" ? "true" : "false"}>Bijbel</a>
					<a href="/over" aria-current={huidigeNav === "over" ? "true" : "false"}>Over</a>
					<a href="/contact" aria-current={huidigeNav === "contact" ? "true" : "false"}>Contact</a>
					<a class="nav-cta" href="/joh/1">Begin met lezen</a>
				</nav>
			</header>
		</div>

		<slot name="hero" />

		<main>
			<slot />
		</main>

		<footer class="foot">
			<p>Een betrouwbare vertaling, in begrijpelijk Nederlands. Volledig licentievrij.</p>
			<span>CC0 — data</span><span>MIT — code</span>
		</footer>

		<div id="toast" class="toast" hidden></div>

		<script>
			let toastTimer: ReturnType<typeof setTimeout>;
			function toonToast(tekst: string) {
				const el = document.getElementById("toast");
				if (!el) return;
				el.textContent = tekst;
				el.hidden = false;
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => { el.hidden = true; }, 2400);
			}
			(window as any).toonToast = toonToast;
		</script>
	</body>
</html>
